{
  "name": "Healf Catalog Audit",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule: Daily 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1b2c3d4-0001-0000-0000-000000000001",
              "name": "webhookUrl",
              "type": "string",
              "value": "http://YOUR_WINDOWS_IP:8000"
            },
            {
              "id": "a1b2c3d4-0001-0000-0000-000000000002",
              "name": "slackUrl",
              "type": "string",
              "value": "https://hooks.slack.com/services/REPLACE_ME"
            }
          ]
        },
        "options": {}
      },
      "id": "7",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Edit this list to add or remove product URLs to audit.\n// Each URL becomes one item processed one at a time.\nconst urls = [\n  'https://healf.com/en-uk/products/lmnt-recharge-electrolytes-variety-pack'\n];\nreturn urls.map(url => ({ json: { url } }));"
      },
      "id": "2",
      "name": "URL List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "3",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.webhookUrl }}/audit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.url }}\",\n  \"draft\": true\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "4",
      "name": "POST /audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "onError": "continueRegularOutput",
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.score }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5",
      "name": "IF score < 3",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.slackUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \":warning: Healf listing needs attention — *{{ $json.product_handle }}* scored {{ $json.score }}/5. Gaps: {{ $json.gaps.join(', ') }}. HITL queue id: {{ $json.hitl_id }}.\"\n}",
        "options": {}
      },
      "id": "6",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "onError": "continueRegularOutput",
      "position": [1560, 200]
    }
  ],
  "connections": {
    "Schedule: Daily 09:00 UTC": {
      "main": [
        [{"node": "Config", "type": "main", "index": 0}]
      ]
    },
    "Config": {
      "main": [
        [{"node": "URL List", "type": "main", "index": 0}]
      ]
    },
    "URL List": {
      "main": [
        [{"node": "Split In Batches", "type": "main", "index": 0}]
      ]
    },
    "Split In Batches": {
      "main": [
        [{"node": "POST /audit", "type": "main", "index": 0}]
      ]
    },
    "POST /audit": {
      "main": [
        [{"node": "IF score < 3", "type": "main", "index": 0}]
      ]
    },
    "IF score < 3": {
      "main": [
        [{"node": "Notify Slack", "type": "main", "index": 0}],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false,
  "versionId": "3"
}
